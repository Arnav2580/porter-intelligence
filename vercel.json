{
  "version": 2,
  "buildCommand": "cd dashboard-ui && npm ci && npm run build",
  "outputDirectory": "dashboard-ui/dist",
  "installCommand": "cd dashboard-ui && npm ci",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dimly-disinfect-upright.ngrok-free.dev/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "ngrok-skip-browser-warning", "value": "true" }
      ]
    }
  ]
}
